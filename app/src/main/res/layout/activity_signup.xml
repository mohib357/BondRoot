<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="নতুন একাউন্ট ও বংশলতিকা সাইন-আপ"
            app:titleTextColor="@android:color/white"
            app:navigationIcon="@android:drawable/ic_menu_revert" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Step 1: Personal Info -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="১. ব্যক্তিগত তথ্য (Personal Information)"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="বাংলায় নাম (Local Name) *"
                android:layout_marginBottom="8dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNameLocal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="ইংরেজি নাম (English Name)"
                android:layout_marginBottom="8dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNameEnglish"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Spinner
                    android:id="@+id/spinnerGender"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@android:drawable/btn_dropdown" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="জন্ম সাল (e.g. 1995)">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDob"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="পেশা (Profession)"
                android:layout_marginBottom="16dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etProfession"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Step 2: Father Selection with Intelligent Match -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="২. পিতা নির্বাচন (Father Search &amp; Selection)"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="পিতার নাম লিখলে সিস্টেম ডুপ্লিকেট এড়াতে সম্ভাব্য ম্যাচ খুঁজে দেবে:"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="বাবার নাম লিখুন (e.g. ইদ্রিস আলী)">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etFatherNameSearch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSearchFather"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:layout_marginStart="8dp"
                    android:text="খুঁজুন"
                    android:backgroundTint="@color/primary" />
            </LinearLayout>

            <!-- Father Candidate List Container -->
            <LinearLayout
                android:id="@+id/layoutFatherCandidates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:padding="8dp"
                android:background="#E8F5E9"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ডাটাবেজে সম্ভাব্য পিতা পাওয়া গেছে (Select Match):"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_dark"
                    android:layout_marginBottom="6dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvFatherCandidates"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFatherNotFound"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="তালিকায় নেই / নতুন পিতা যুক্ত করুন (Add as New Father)"
                    android:backgroundTint="#6C757D" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSelectedFatherStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="নির্বাচিত পিতা: এখনো নির্বাচন করা হয়নি"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="16dp" />

            <!-- Step 3: Mother Selection with Intelligent Match -->
            <TextView
                android:id="@+id/tvStepMotherTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="৩. মাতা নির্বাচন (Mother Search &amp; Selection)"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvMotherSearchDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="মাতার নাম লিখলে সিস্টেম ডুপ্লিকেট এড়াতে সম্ভাব্য ম্যাচ খুঁজে দেবে:"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilMotherNameSearch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="মাতার নাম লিখুন">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etMotherNameSearch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSearchMother"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:layout_marginStart="8dp"
                    android:text="খুঁজুন"
                    android:backgroundTint="@color/primary" />
            </LinearLayout>

            <!-- Mother Candidate List Container -->
            <LinearLayout
                android:id="@+id/layoutMotherCandidates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:padding="8dp"
                android:background="#FCE4EC"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvCandidateMotherHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ডাটাবেজে সম্ভাব্য মাতা পাওয়া গেছে (Select Match):"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#C2185B"
                    android:layout_marginBottom="6dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvMotherCandidates"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMotherNotFound"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="তালিকায় নেই / নতুন মাতা যুক্ত করুন (Add as New Mother)"
                    android:backgroundTint="#6C757D" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSelectedMotherStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="নির্বাচিত মাতা: এখনো নির্বাচন করা হয়নি"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="16dp" />

            <!-- Step 4: Account Info -->
            <TextView
                android:id="@+id/tvStepAccountTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="৪. একাউন্ট লগইন তথ্য (User Account)"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="ইমেইল (Email) *"
                android:layout_marginBottom="8dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="পাসওয়ার্ড (Password) *"
                android:layout_marginBottom="16dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Submit Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitSignup"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="রেজিস্ট্রেশন সম্পন্ন করুন (Complete Sign Up)"
                android:textSize="15sp"
                android:textStyle="bold"
                android:backgroundTint="@color/primary"
                android:textColor="@android:color/white"
                app:cornerRadius="12dp"
                android:layout_marginBottom="24dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

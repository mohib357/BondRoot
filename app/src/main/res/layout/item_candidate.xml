<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="1dp"
    app:strokeColor="#C8E6C9"
    app:strokeWidth="1dp"
    android:backgroundTint="@color/card_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCandidateName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="মোঃ ইদ্রিস আলী"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvCandidateFather"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="পিতা: মোহাম্মদ আলী • জন্ম: 1968"
                android:textSize="11sp"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/tvCandidateId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Person ID: P100003"
                android:textSize="10sp"
                android:textColor="@color/primary" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSelectCandidate"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="ইনিই পিতা"
            android:textSize="11sp"
            android:backgroundTint="@color/primary"
            android:textColor="@android:color/white"
            app:cornerRadius="8dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

# =====================================================
# BondRoot — Environment Variables Template
# Copy this file to .env and fill in all values.
# NEVER commit your actual .env file to version control.
# =====================================================

# --- PostgreSQL (Neon) ---
# Get these from https://console.neon.tech → Connection Details
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL_POOLED=postgresql://user:password@host-pooler/dbname?sslmode=require

# --- Auth (JWT Signing Secret) ---
# Generate a strong random value: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# REQUIRED — server will refuse to start without this
AUTH_SECRET=

# --- Google Gemini AI ---
# Get from https://aistudio.google.com/app/apikey
# REQUIRED for AI features (Smart Add, Kinship Explainer, Bio Generator, Lineage Insights)
GEMINI_API_KEY=

# --- Neon S3-Compatible Object Storage ---
# Get from https://console.neon.tech → Storage tab
AWS_ENDPOINT_URL_S3=https://your-bucket-region.storage.neon.tech
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1

# --- Server ---
PORT=3000
NODE_ENV=development

# --- CORS (Production only) ---
# Comma-separated list of allowed origins, e.g. https://bondroot.app,https://www.bondroot.app
# In development, all origins are allowed.
ALLOWED_ORIGINS=

# --- Frontend (Vite) ---
# Public-facing API URL (used by frontend in production builds)
VITE_API_URL=https://your-app.onrender.com
